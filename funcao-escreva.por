programa {
  funcao inicio() {
    cadeia nome
    inteiro pontos, idade 

    nome = "Luccas"
    pontos = 1500
    idade = 17
    escreva("Ola, mundo! \n")
    escreva(nome, " tem ", idade, " anos de idade. \n")
    escreva(nome, " tem ", idade, " anos de idade, cerca de ", pontos, " pontos na cartola em toda sua carreira")
  }
}
